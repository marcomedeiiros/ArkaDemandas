# Credenciais de login social (opcional).
# Copie este arquivo para ".env" (na pasta server/) e preencha os valores.
# Sem isto, o login por e-mail/senha continua funcionando normalmente; apenas
# os botões Google/Microsoft ficam indisponíveis.

# URLs (só precisa mudar se não usar as portas padrão)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001

# Google  → https://console.cloud.google.com/apis/credentials
# Redirect URI autorizado: http://localhost:3001/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Azure) → https://portal.azure.com  (Azure Active Directory > App registrations)
# Redirect URI (Web): http://localhost:3001/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
